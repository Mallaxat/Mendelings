<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mendelings.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
        x:Class="Mendelings.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mendelings">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid 
        ShowGridLines="True"
        RowDefinitions="0.5*,1*,10*,0.5*"
        ColumnDefinitions="0.5*,10*,0.5*">
        <ContentControl x:Name="PageContent"
                        Grid.Column="1"
                        Grid.Row="2"/>
        <StackPanel x:Name="ButtonsStackPanel"
                    Grid.Column="1"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="5">
            <Button x:Name="MainButton"
                    Content="Уход за питомцем"
                    Click="MainButton_Click"
                    />
            <Button x:Name="BreedingButton"
                    Content="К разведению"
                    Click="BreedingButton_Click"
                    />
            <Button x:Name="FamilyButton"
                    Content="К древу"
                    Click="FamilyButton_Click"
                    />
            
        </StackPanel>


  

    </Grid>



</Window>
