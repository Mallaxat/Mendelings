<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Mendelings.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="Mendelings.Views.PetModelWindow"
        x:DataType="vm:PetViewModel"
        Title="PetModelWindow">


  <Grid ShowGridLines="True"
        RowDefinitions="1*,1*,1*,1*"
        ColumnDefinitions="1*,1*,1*,1*"
        >
      <Button Grid.Column="0"
             Grid.Row="0"
             Content="Load"
             Command="{Binding LoadPetCommand}">
          
      </Button>
      <Label Grid.Column="1"
             Grid.Row="1"
             Content="{Binding CurrentPet.BodyGene}"
             Background="Green">
          
      </Label>

  </Grid>
</Window>
