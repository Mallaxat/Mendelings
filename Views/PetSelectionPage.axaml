<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Mendelings.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
        x:Class="Mendelings.Views.PetSelectionPage"
        x:DataType="vm:PetSelectionViewModel"
        Title="Mendelings"
        WindowState="Maximized"
        Icon="/Assets/Level0/icons_main.png">
    <Grid ClipToBounds="True">
        <!--Задний фон-->
        <Grid Grid.Column="0"
              Grid.ColumnSpan="2"
              ShowGridLines="False"
              RowDefinitions="1*,1*,1*"
              ColumnDefinitions="1*,1*"
              >
            <Image Grid.Row="0"
                   Grid.RowSpan="3"
                   Grid.Column="0" Grid.ColumnSpan="2"
                   Stretch="UniformToFill"
                   Source="/Assets/Level2/BackgroundNonCarpet.png"/>
        </Grid>
        <Viewbox Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">


            <Grid x:Name="GridMainSelect"
                  Height="450"
                  Width="900"
                  ShowGridLines="False"
                  ColumnDefinitions="1*,2*">


                <Grid Grid.Column="0"
                      ShowGridLines="False"
                      RowDefinitions="1*,6*">

                    <ListBox x:Name="PetsItemsListBox"
                             Grid.Column="0"
                             Grid.Row="1"
                             ItemsSource="{Binding PetsItemsList}"
                             SelectedItem="{Binding SelectPet, Mode=TwoWay}"
                             Margin="5"
                             CornerRadius="5"
                             Background="#80FFFFFF">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    CornerRadius="5"
                                    Padding="15"
                                    Background="#d8ecfc"
                                    Tapped="PetItem_Tapped">
                                    <Grid
                                        ColumnDefinitions="1*,1*"
                                        ColumnSpacing="10">
                                        <TextBlock Text="{Binding ItemPets.Name}"
                                                   Grid.Column="0"
                                                   Foreground="#17396D"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ItemPets.Sex}"
                                                   Grid.Column="1"
                                                   Foreground="#17396D"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"/>

                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                    <Border Margin="5"
                            Grid.Row="0"
                            Background="#d8ecfc"
                            CornerRadius="9"
                            Padding="2">
                        <Label Content="Доступные для выбора питомцы"
                               Grid.Column="0" Grid.ColumnSpan="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,0,0,0"
                               Classes="TextStyle"/>
                    </Border>


                </Grid>


                <!--Инфа-->
                <Grid Grid.Column="1"
                      ShowGridLines="False"
                      RowDefinitions="2*,1*"
                      ColumnDefinitions="2*,1*"
                      Margin="0,0,5,0"
                      >
                    <Image Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="0"
                           Margin="55,15,55,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Stretch="Uniform"
                           
                           Source="/Assets/Level2/Carpet.png"/>
                    <Border Grid.Column="1"
                            Grid.RowSpan="2"
                            Background="#f4f9fd"
                            VerticalAlignment="Top"
                            CornerRadius="10"
                            Padding="0,5,5,15">

                        <StackPanel
                            Grid.Row="0"
                            Spacing="5">
                            <Grid RowDefinitions="1*,1*">
                                <Border Margin="1,5,1,0"
                                        Background="#d8ecfc"
                                        CornerRadius="9"
                                        Padding="2">
                                    <Label Content="Информация о питомце"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Margin="0,0,0,0"
                                           Classes="TextStyle"/>
                                </Border>
                            </Grid>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Имя:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.Name}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Пол:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.Sex}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Поколение:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.Generation}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Настроение:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.Mood}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>
                            <Border Background="#17396D"
                                    Height="2"
                                    CornerRadius="5"/>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Ген тела:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.BodyGene}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Ген головы:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.HeadGene}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Ген хвоста:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.TailGene}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Ген глаз:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.EyesGene}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Ген ушей:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.EarsGene}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>
                            <Border Margin="10,0,10,0"
                                    Background="#d8ecfc"
                                    CornerRadius="9"
                                    Padding="2">
                                <Grid ColumnDefinitions="1*,1*">
                                    <Label Content="Ген рогов:"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                    <Label Content="{Binding SelectPet.ItemPets.HornsGene}"
                                           Grid.Column="1" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Classes="TextStyle"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!--Питомец-->
                    <Grid x:Name="ImagePetGrid"
                          Grid.Column="0"
                          Grid.Row="0" Grid.RowSpan="2"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,50">

                        <Image x:Name="BodySelectPetImage"
                               Source="{Binding SelectPet.ItemAppearancePets.BodyImage}"
                               ZIndex="2"
                               Margin="0,10,10,2"
                               Classes="Breathing"/>

                        <Image x:Name="HeadSelectPetImage"
                               Margin="0,10,10,2"
                               Source="{Binding SelectPet.ItemAppearancePets.HeadImage}"
                               ZIndex="3"/>

                        <Image x:Name="TailSelectPetImage"
                               Margin="0,10,10,2"
                               Source="{Binding SelectPet.ItemAppearancePets.TailImage}"
                               ZIndex="1"
                               Classes="TailMove"/>

                        <Image x:Name="EyesSelectPetImage"
                               Margin="0,10,10,2"
                               Source="{Binding SelectPet.ItemAppearancePets.EyesImage}"
                               ZIndex="5"
                               Classes="Blink AutoBlink"/>

                        <Image x:Name="EyesCloseSelectPetImage"
                               Margin="0,10,10,2"
                               Source="{Binding SelectPet.ItemAppearancePets.EyesCloseImage}"
                               ZIndex="4"/>

                        <Image x:Name="EarsSelectPetImageLeft"
                               Margin="0,10,10,2"
                               Source="{Binding SelectPet.ItemAppearancePets.EarsLeftImage}"
                               ZIndex="2"
                               Classes="EarLeftMove"
                               RenderTransformOrigin="38%,22%"/>

                        <Image x:Name="EarsSelectPetImageRight"
                               Margin="0,10,10,2"
                               Source="{Binding SelectPet.ItemAppearancePets.EarsRightImage}"
                               ZIndex="2"
                               Classes="EarRightMove"
                               RenderTransformOrigin="62%,22%"/>

                        <Image x:Name="HornsSelectPetImage"
                               Margin="0,10,10,2"
                               Source="{Binding SelectPet.ItemAppearancePets.HornsImage}"
                               ZIndex="1"/>
                    </Grid>

                    <!--Кнопка-->
                    <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                    <Button x:Name="SendPetButton"
                            Margin="0,0,0,30"
                            Click="SendPetButton_Click"
                            Classes="ButtonStyle"
                            >
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Level1/Buttons/icon_select.png"
                                   Width="25"
                                   Height="20"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Stretch="Uniform"/>
                            <TextBlock Text="Выбрать питомца"
                                       FontFamily="Segoe UI"
                                       FontWeight="SemiBold"
                                       Foreground="#d8ecfc"/>

                        </StackPanel>
                    </Button>

                        </StackPanel>

                </Grid>


            </Grid>
        </Viewbox>
    </Grid>
</Window>
