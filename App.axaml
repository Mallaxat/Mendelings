<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mendelings.App"
             xmlns:local="using:Mendelings"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Animations/Blink.axaml" />
        <StyleInclude Source="/Styles/Animations/Breathing.axaml" />
        <StyleInclude Source="/Styles/Animations/EarsMoveLeft.axaml" />
        <StyleInclude Source="/Styles/Animations/EarsMoveRight.axaml" />
         <StyleInclude Source="/Styles/Animations/TailMove.axaml" />
    </Application.Styles>
</Application>