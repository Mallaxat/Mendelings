<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Базовое состояние: глаза открыты -->
    <Style Selector="Image.Blink">
        <Setter Property="OpacityMask">
            <LinearGradientBrush StartPoint="0%,0%"
                                 EndPoint="0%,100%">
                <GradientStop Color="Transparent" Offset="0"/>
                <GradientStop Color="Transparent" Offset="0"/>
                <GradientStop Color="Black" Offset="0"/>
                <GradientStop Color="Black" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
    </Style>


    <!-- ============================================ -->
    <!-- АВТОМАТИЧЕСКОЕ МОРГАНИЕ                       -->
    <!-- ============================================ -->

    <Style Selector="Image.Blink.AutoBlink">
        <Style.Animations>

            <Animation Duration="0:0:12"
                       IterationCount="INFINITE">

                <!-- Открыт -->
                <KeyFrame Cue="0%">
                    <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0%,0%"
                                             EndPoint="0%,100%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter>
                </KeyFrame>

                <!-- Долго остаётся открытым -->
                <KeyFrame Cue="96.8%">
                    <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0%,0%"
                                             EndPoint="0%,100%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter>
                </KeyFrame>

                <!-- Закрывается -->
                <KeyFrame Cue="98.1%">
                    <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0%,0%"
                                             EndPoint="0%,100%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                            <GradientStop Color="Black" Offset="1"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter>
                </KeyFrame>

                <!-- Немного закрыт -->
                <KeyFrame Cue="98.7%">
                    <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0%,0%"
                                             EndPoint="0%,100%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                            <GradientStop Color="Black" Offset="1"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter>
                </KeyFrame>

                <!-- Открывается -->
                <KeyFrame Cue="100%">
                    <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0%,0%"
                                             EndPoint="0%,100%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter>
                </KeyFrame>

            </Animation>

        </Style.Animations>
    </Style>


    <!-- ============================================ -->
    <!-- ЗАКРЫТЬ ГЛАЗА                                -->
    <!-- ============================================ -->

    <Style Selector="Image.Blink.EyesClosed">
        <Style.Animations>

            <Animation Duration="0:0:0.18"
                       IterationCount="1"
                       FillMode="Forward">

                <!-- Открыт -->
                <KeyFrame Cue="0%">
                    <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0%,0%"
                                             EndPoint="0%,100%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter>
                </KeyFrame>

                <!-- Закрыт -->
                <KeyFrame Cue="100%">
                    <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0%,0%"
                                             EndPoint="0%,100%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                            <GradientStop Color="Black" Offset="1"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter>
                </KeyFrame>

            </Animation>

        </Style.Animations>
    </Style>


    <!-- ============================================ -->
    <!-- ОТКРЫТЬ ГЛАЗА                                -->
    <!-- ============================================ -->

    <Style Selector="Image.Blink.EyesOpen">
        <Style.Animations>

            <Animation Duration="0:0:0.22"
                       IterationCount="1"
                       FillMode="Forward">

                <!-- Закрыт -->
                <KeyFrame Cue="0%">
                    <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0%,0%"
                                             EndPoint="0%,100%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                            <GradientStop Color="Black" Offset="1"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter>
                </KeyFrame>

                <!-- Открыт -->
                <KeyFrame Cue="100%">
                    <Setter Property="OpacityMask">
                        <LinearGradientBrush StartPoint="0%,0%"
                                             EndPoint="0%,100%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter>
                </KeyFrame>

            </Animation>

        </Style.Animations>
    </Style>

</Styles>
