<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>
    <Style Selector="Image.Breathing">

    <!-- Масштабируем относительно нижнего центра -->
    <Setter Property="RenderTransformOrigin" Value="50%,100%" />

    <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="1"
                        ScaleY="1" />
    </Setter>

    <Style.Animations>
        <Animation Duration="0:0:4"
                   IterationCount="INFINITE"
                   Easing="SineEaseInOut">

            <!-- Обычное состояние -->
            <KeyFrame Cue="0%">
                <Setter Property="ScaleTransform.ScaleX" Value="1" />
                <Setter Property="ScaleTransform.ScaleY" Value="1" />
            </KeyFrame>

            <!-- Вдох -->
            <KeyFrame Cue="50%">
                <Setter Property="ScaleTransform.ScaleX" Value="1.018" />
                <Setter Property="ScaleTransform.ScaleY" Value="1.012" />
            </KeyFrame>

            <!-- Выдох -->
            <KeyFrame Cue="100%">
                <Setter Property="ScaleTransform.ScaleX" Value="1" />
                <Setter Property="ScaleTransform.ScaleY" Value="1" />
            </KeyFrame>

        </Animation>
    </Style.Animations>

</Style>
</Styles>
